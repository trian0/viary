<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- DUMP is only held by shell/system, so only `adb shell am broadcast` can trigger seeding -->
        <receiver
            android:name=".benchmark.SeedBenchmarkDataReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
